{
  "description": "AI_saver — 실행 전 확인과 세션 종료 집계 (Codex)",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"<AI_saver를 내려받은 경로>/hooks/codex_on_prompt.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"<AI_saver를 내려받은 경로>/hooks/codex_on_session_end.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
